{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Feedback": ""
  },
  "Ai": {
    "TimeoutSeconds": 60,
    "Steps": {
      "Embed": { "Model": "text-embedding-3-small" },
      "Match": { "Model": "gpt-6-luna", "Effort": "minimal" },
      "Score": { "Model": "gpt-6-luna", "Effort": "none", "Temperature": 0 }
    },
    "Prices": {
      "text-embedding-3-small": { "InputPerMillion": 0.02, "OutputPerMillion": 0 },
      "gpt-6-luna": { "InputPerMillion": 0.10, "OutputPerMillion": 0.50 },
      "gpt-6.1-sol": { "InputPerMillion": 2.00, "OutputPerMillion": 10.00 }
    }
  },
  "Portal": {
    "RateLimit": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  },
  "PriorityCriteria": {
    "Goals": [
      "Help students find new study spots",
      "Make students come back",
      "Grow the social side"
    ],
    "CoreTasks": "finding a spot, adding or rating a spot, logging a visit, following friends",
    "Weights": { "StrategicFit": 30, "Reach": 30, "Pain": 25, "RetentionRisk": 15 },
    "Levels": {
      "StrategicFit": [
        "Serves none of the goals",
        "Touches a goal only indirectly",
        "Clearly supports one goal in a small way",
        "Directly advances one goal",
        "Substantially advances a goal, or advances more than one"
      ],
      "Pain": [
        "Nice to have; the app works fine without it",
        "Minor annoyance, easy workaround",
        "Noticeable friction in a regular task; clumsy workaround",
        "Makes a core task hard or unreliable",
        "Blocks a core task, or makes the app unusable for some students"
      ],
      "RetentionRisk": [
        "No sign anyone would leave",
        "Mild frustration, no talk of leaving",
        "Says they use the app less or avoid a feature",
        "Mentions switching to another app or tool",
        "Says they've stopped using or uninstalled Studease"
      ]
    },
    "ReachBands": [
      { "MinPoints": 0, "Rating": 1 },
      { "MinPoints": 3, "Rating": 2 },
      { "MinPoints": 10, "Rating": 3 },
      { "MinPoints": 20, "Rating": 4 },
      { "MinPoints": 40, "Rating": 5 }
    ],
    "CutOffs": { "High": 70, "Medium": 40 }
  },
  "Suggest": {
    "ShowThreshold": 0.30,
    "StrongThreshold": 0.60,
    "MaxResults": 4,
    "MinChars": 4
  }
}
